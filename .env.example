# GitHub Configuration
# Get token at: https://github.com/settings/tokens
# Required scopes: repo, workflow, admin:org (for Projects)
GITHUB_TOKEN=ghp_your_github_token_here

# Repository Information
# Format: owner/repo (e.g., YourUsername/my-project)
REPOSITORY=taiyousan15/tepure

# Anthropic API Key (optional for local development)
# Get key at: https://console.anthropic.com/
# Required for running agents locally
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Device Identifier (for logging)
DEVICE_IDENTIFIER="MacBook Pro"

# ===== Figma Template Automation =====

# Flask Backend
JWT_SECRET=your_jwt_secret_key_here_change_in_production
FLASK_ENV=development
PORT=5000

# Google Sheets (Database)
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json

# Figma API
FIGMA_PERSONAL_ACCESS_TOKEN=figd_your_figma_token_here

# Agent Configuration
LOG_DIRECTORY=.ai/logs
REPORT_DIRECTORY=.ai/parallel-reports
DEFAULT_CONCURRENCY=2

# Development Options
USE_TASK_TOOL=false
USE_WORKTREE=false
