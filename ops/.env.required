# ==== 必須環境変数リスト (17項目) ====
# このファイルは ops/check-secrets.py が読み込みます
# 末尾に ? がある行は optional（警告のみ）
# Updated: 2025-10-16

# ==== Security (2項目) ====
JWT_SECRET
REFRESH_SECRET

# ==== Google Sheets (5項目) ====
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64
SHEETS_USERS_ID
SHEETS_TEMPLATES_ID
SHEETS_JOBS_ID
SHEETS_AUDITLOGS_ID

# ==== LLM API (1項目) ====
ANTHROPIC_API_KEY

# ==== Monitoring & Alerts (6項目) ====
SENTRY_DSN
GA_MEASUREMENT_ID
ERROR_RATE_THRESHOLD
ERROR_RATE_WINDOW_MINUTES
LATENCY_P95_THRESHOLD_MS
DAILY_COST_THRESHOLD_USD

# ==== External Services (1項目) ====
FIGMA_API_TOKEN

# ==== Infrastructure (1項目) ====
GCP_PROJECT_ID

# ==== Optional (1項目) ====
APP_VERSION?
GIT_COMMIT?
